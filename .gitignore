# Environment & Secrets (Keep .env.example tracked)
.env
.env.local
.env.*.local
!.env.example

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Frontend dependencies & build output
node_modules/
frontend/node_modules/
frontend/dist/
*.tsbuildinfo
frontend/*.tsbuildinfo
.npm/

# Runtime evidence, generated reports, logs & trained models
instance/uploads/*
!instance/uploads/.gitkeep
instance/reports/*
!instance/reports/.gitkeep
instance/models/*
!instance/models/.gitkeep
instance/*.log
*.log

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo