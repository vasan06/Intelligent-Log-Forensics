# Flask/JWT
ILF_JWT_SECRET=replace-with-a-long-random-secret
ILF_JWT_ALGORITHM=HS256
ILF_JWT_ACCESS_EXPIRES=3600
ILF_JWT_REFRESH_EXPIRES=2592000
ILF_COOKIE_SECURE=false

# PostgreSQL
ILF_DB_HOST=localhost
ILF_DB_PORT=5432
ILF_DB_NAME=ilf_db
ILF_DB_USER=ilf_user
ILF_DB_PASSWORD=replace-with-your-database-password
# Optional full SQLAlchemy URL; when set, this takes precedence over the fields above.
# ILF_DATABASE_URL=postgresql+psycopg://ilf_user:your-password@localhost:5432/ilf_db
DATABASE_URL=sqlite:///instance/ilf.db

# Initial administrator; replace both values before running the application.
ILF_ADMIN_EMAIL=admin@example.invalid
ILF_ADMIN_PASSWORD=replace-with-your-own-password
ADMIN_EMAIL=admin@ilf.local
ADMIN_PASSWORD=changeme

# Optional email delivery for password reset and one-time codes.
ILF_SMTP_HOST=
ILF_SMTP_PORT=587
ILF_SMTP_USER=
ILF_SMTP_PASS=
ILF_SMTP_FROM=
ILF_OTP_LENGTH=6
ILF_OTP_EXPIRY_SECONDS=1800

# Comma-separated browser origins allowed by Flask-CORS.
ILF_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
ILF_LOG_LEVEL=INFO
